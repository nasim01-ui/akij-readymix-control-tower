# --- Akij Readymix Control Tower backend ---
# Copy to .env for LOCAL dev only. On Render, set these values in the
# Render dashboard (Environment tab), NOT in this file.
#
# SECURITY: placeholders only - NEVER commit real credentials.

MSSQL_SERVER=YOUR_MSSQL_SERVER_HOST
MSSQL_PORT=1433
MSSQL_USER=YOUR_MSSQL_USER
MSSQL_PASSWORD=YOUR_MSSQL_PASSWORD
MSSQL_DATABASE=DWH
MSSQL_BU_ID=175

# Flask
SECRET_KEY=change-me-in-production
DEBUG=False

# Comma-separated allowed origins for CORS (frontend static site URL)
CORS_ORIGINS=*